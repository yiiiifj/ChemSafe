# ===== DeepSeek 文本模型（对话 / 建议生成，必填）=====
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek API 地址（一般不需要改）
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# 模型名称（deepseek-chat 即 DeepSeek-V3）
DEEPSEEK_MODEL=deepseek-chat

# ===== 视觉模型（图片识别，可选）=====
# 注意：deepseek-chat 是纯文本模型，不支持图片输入，不能用于图片识别。
# 若需拍照识别，请填写任意 OpenAI 兼容的多模态接口；留空则图片识别自动降级为
# OCR（Tesseract）+ 文件名匹配，功能仍可用但准确率较低。
#
# 通义千问示例：
# VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# VISION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VISION_MODEL=qwen-vl-max
#
# 智谱 GLM 示例（glm-4v-flash 目前免费，推荐）：
# VISION_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# VISION_API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx
# VISION_MODEL=glm-4v-flash
#
# 商汤日日新示例（公测期免费）：
# VISION_API_URL=https://token.sensenova.cn/v1/chat/completions
# VISION_MODEL=sensenova-6.8-flash-lite
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=

# ===== 服务配置 =====
# JWT 签名密钥（生产环境必须设置固定强随机值；不设置则每次启动随机生成，
# 重启后所有用户登录态失效）
JWT_SECRET_KEY=

# 允许跨域访问的来源，多个用逗号分隔；留空或 * 表示不限制（仅建议本地开发使用）
CORS_ORIGINS=

# OCR 前把图片缩到的最长边（像素）。手机照片常有 3000~4000px，
# 直接送入 OCR 峰值内存会飙到 600MB+，在 512MB 的免费实例上会 OOM 被杀（表现为 502）。
# 默认 1280（实测峰值约 356MB）。实例内存更小可调到 1024；识别小字不清可调到 1600。
OCR_MAX_SIDE=1280

# 是否信任反向代理的 X-Forwarded-For（用于接口限流识别真实客户端 IP）
# 部署在 Render / nginx 等代理后：1（默认）
# 直接暴露、前面没有代理：0（否则客户端可伪造 IP 绕过限流）
TRUST_PROXY=1

# ===== 邮箱找回密码（可选，不配置则该功能不可用）=====
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_BASE_URL=http://localhost:5000
